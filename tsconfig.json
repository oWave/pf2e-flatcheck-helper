{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"ESNext",
			"ESNext.Array",
			"DOM",
			"DOM.Iterable"
		],
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noImplicitAny": false,
		"verbatimModuleSyntax": true,
		"types": [
			"@7h3laughingman/pf2e-types",
			"jquery",
			"vite/client",
		],
		"paths": {
			"src": [
				"./src/index"
			],
			"src/*": [
				"./src/*"
			]
		},
	},
	"include": [
		"./src/**/*"
	]
}